{
  "name": "shuben-launcher",
  "version": "1.0.0",
  "description": "Shuben Launcher: Minecraft launcher with Microsoft login, mod store, skins & capes, one-click servers",
  "main": "main.js",
  "author": "Shuben",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dist:win-on-linux": "electron-builder --win portable -c.win.signAndEditExecutable=false",
    "dist:mac": "electron-builder --mac dmg"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.4"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.shuben.launcher",
    "productName": "Shuben Launcher",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "ShubenLauncher.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.games"
    },
    "dmg": {
      "artifactName": "ShubenLauncher-${arch}.dmg"
    }
  }
}